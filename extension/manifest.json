{
  "manifest_version": 2,
  "name": "Lume",
  "version": "0.1.0",
  "description": "Lume — what to read next, locally. Reads pages on-device, embeds them with a small sentence-transformer model, and ranks them against a live news feed. Embedding and similarity matching stay on your device.",

  "browser_specific_settings": {
    "gecko": {
      "id": "lume@cleartextlabs.com",
      "strict_min_version": "115.0"
    }
  },

  "permissions": [
    "storage",
    "tabs",
    "<all_urls>"
  ],

  "background": {
    "page": "background/background.html",
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.gmail.com/*",
        "*://accounts.google.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["content/popup.js", "content/content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Lume — what to read next"
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "web_accessible_resources": [
    "content/popup.css",
    "lib/ort-wasm-simd-threaded.jsep.wasm"
  ],

  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co https://story-discovery-feed.digitalhen.workers.dev; img-src 'self' data: https://* http://*"
}
